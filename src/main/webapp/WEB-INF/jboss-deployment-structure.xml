<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <!-- Define module dependencies -->
        <dependencies>
            <!-- H2 Database Driver Module -->
            <module name="com.h2database.h2" />
        </dependencies>
        
        <!-- Exclude conflicting modules to avoid classloader issues -->
        <exclusions>
            <!-- Exclude WildFly's JSF implementation to use the one bundled with the WAR -->
            <module name="javax.faces.api" />
            <module name="com.sun.jsf-impl" />
        </exclusions>
        
        <!-- Local resources take precedence over module resources -->
        <local-last value="false"/>
    </deployment>
</jboss-deployment-structure>