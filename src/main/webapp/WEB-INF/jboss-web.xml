<?xml version="1.0" encoding="UTF-8"?>
<jboss-web xmlns="http://www.jboss.com/xml/ns/javaee"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://www.jboss.com/xml/ns/javaee
           http://www.jboss.org/schema/jbossas/jboss-web_14_0.xsd"
           version="14.0">

    <!-- Context root for the application -->
    <context-root>/phonebook</context-root>
    
    <!-- Security domain (if needed for future authentication) -->
    <!-- <security-domain>other</security-domain> -->
    
    <!-- Enable JSF development mode for debugging -->
    <enable-websockets>false</enable-websockets>
    
    <!-- Disable file system deployment scanner for this app -->
    <disable-audit>false</disable-audit>
    
</jboss-web>