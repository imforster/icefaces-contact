<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
         http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0">

    <display-name>ICEfaces Phone Book Application</display-name>
    <description>A phone book application built with ICEfaces 4 and JSF</description>

    <!-- JSF Configuration -->
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <context-param>
        <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <context-param>
        <param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ICEfaces Configuration Parameters -->
    <context-param>
        <param-name>org.icefaces.ace.theme</param-name>
        <param-value>rime</param-value>
    </context-param>
    
    <!-- ICEfaces ACE Components Configuration -->
    <context-param>
        <param-name>org.icefaces.mandatoryResourceConfiguration</param-name>
        <param-value>all</param-value>
    </context-param>
    
    <context-param>
        <param-name>org.icefaces.compressResources</param-name>
        <param-value>false</param-value>
    </context-param>
    
    <!-- Force ICEfaces ACE component loading -->
    <context-param>
        <param-name>org.icefaces.ace.component.loadAll</param-name>
        <param-value>true</param-value>
    </context-param>
    
    <!-- ICEfaces Resource Loading -->
    <context-param>
        <param-name>org.icefaces.coalesceResources</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>org.icefaces.ace.combinedResourceMode</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>org.icefaces.strictSessionTimeout</param-name>
        <param-value>false</param-value>
    </context-param>

    <context-param>
        <param-name>org.icefaces.sessionExpiredRedirectURI</param-name>
        <param-value>/contacts.xhtml</param-value>
    </context-param>

    <!-- Enable ICEfaces ACE components -->
    <context-param>
        <param-name>org.icefaces.ace.enabled</param-name>
        <param-value>true</param-value>
    </context-param>
    
    <!-- ICEfaces Resource Servlet Configuration -->
    <context-param>
        <param-name>org.icefaces.resourceRootPath</param-name>
        <param-value>/</param-value>
    </context-param>

    <!-- Resource handling configuration -->
    <context-param>
        <param-name>javax.faces.WEBAPP_RESOURCES_DIRECTORY</param-name>
        <param-value>/resources</param-value>
    </context-param>

    <!-- JSF Servlet Configuration -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    


    <!-- Welcome file configuration -->
    <welcome-file-list>
        <welcome-file>contacts.xhtml</welcome-file>
    </welcome-file-list>

    <!-- Session timeout (30 minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- MIME type mappings for ICEfaces resources -->
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>

    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>

    <mime-mapping>
        <extension>png</extension>
        <mime-type>image/png</mime-type>
    </mime-mapping>

    <mime-mapping>
        <extension>gif</extension>
        <mime-type>image/gif</mime-type>
    </mime-mapping>

    <mime-mapping>
        <extension>jpg</extension>
        <mime-type>image/jpeg</mime-type>
    </mime-mapping>

</web-app>